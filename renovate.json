{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "§2.3 patch/minor รวมเป็น PR รายสัปดาห์ · major แยก PR ทีละตัว · ไม่รับเวอร์ชันที่ปล่อยไม่ถึง 3 วัน",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "Asia/Bangkok",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true },
  "vulnerabilityAlerts": {
    "description": "§10.14 แพตช์ความปลอดภัยไม่รอรอบรายสัปดาห์",
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "รวม patch/minor ทั้งหมดเป็น PR เดียวต่อสัปดาห์",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Next.js + React อัปเดตพร้อมกันเสมอ",
      "matchPackageNames": ["next", "react", "react-dom", "eslint-config-next", "@types/react", "@types/react-dom"],
      "groupName": "next + react"
    },
    {
      "description": "typescript-eslint ยังรองรับ TypeScript < 6.1 เท่านั้น — ปลดเมื่อ typescript-eslint รองรับรุ่นใหม่",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    }
  ]
}
