# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env จริง

# ---------- จำเป็น ----------
# รหัสผ่านเข้าหน้าเว็บ (อย่างน้อย 10 ตัวอักษร)
ADMIN_PASSWORD=
# กุญแจเข้ารหัส token ของแพลตฟอร์ม — สร้างด้วย: openssl rand -base64 32
TOKEN_ENC_KEY=

# URL สาธารณะแบบ https ของเซิร์ฟเวอร์นี้ (เช่น https://social.techforce.co.th)
# ใช้เป็น redirect URI ของ OAuth และลิงก์รูปที่ Instagram / LINE / TikTok ดึงไป
# ทดสอบในเครื่อง: ใช้ tunnel เช่น cloudflared หรือ ngrok แล้วใส่ URL ที่ได้
PUBLIC_BASE_URL=
PORT=8787
# 0.0.0.0 = เปิดให้เครื่องอื่นเข้าได้ (ตอน deploy) · 127.0.0.1 = เฉพาะเครื่องนี้
HOST=127.0.0.1

# 1 = ไม่เรียก API จริง (ทดสอบระบบตั้งเวลา/หน้าเว็บโดยไม่ต้องมีบัญชี)
DRY_RUN=0

# ---------- Facebook Page + Instagram (Meta for Developers) ----------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---------- TikTok (TikTok for Developers · Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------- X (developer.x.com · OAuth 2.0) ----------
X_CLIENT_ID=
X_CLIENT_SECRET=

# LINE OA ไม่ต้องตั้งที่นี่ — กรอก Channel access token ของแต่ละ OA ในหน้า "บัญชีที่เชื่อม"
