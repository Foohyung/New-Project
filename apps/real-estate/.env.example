# คัดลอกเป็น .env.local แล้วแก้ค่า — ห้าม commit ไฟล์ .env จริง (§10.8)

# URL หลักของเว็บ ใช้กับ canonical, sitemap และ Open Graph (§16)
SITE_URL=http://localhost:3002

# header ที่เชื่อถือได้สำหรับ IP ของผู้ใช้ (ใช้กับ rate limit ของฟอร์มนัดชม)
# production หลัง Cloudflare ให้ใช้ cf-connecting-ip — x-forwarded-for ปลอมได้ถ้าไม่มี proxy เขียนทับ
TRUSTED_IP_HEADER=x-forwarded-for
