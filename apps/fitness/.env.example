# คัดลอกเป็น .env (หรือ .env.local บนเครื่องพัฒนา) แล้วแก้ค่า — ห้าม commit ไฟล์ .env จริง (§10.8)

# ฐานข้อมูล MySQL 8 (utf8mb4): mysql://ผู้ใช้:รหัสผ่าน@host:3306/ชื่อฐานข้อมูล
# รหัสผ่านที่มีอักขระพิเศษ (@ : / # ?) ต้อง encode เช่น @ → %40
DATABASE_URL=mysql://fitflow:change-me@127.0.0.1:3306/fitflow

# บัญชีเจ้าของคนแรก — สร้างตอนรัน pnpm db:seed (รันซ้ำได้ ไม่เปลี่ยนรหัสผ่านบัญชีที่มีแล้ว)
SEED_OWNER_LOGIN=owner@fitflow.test
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=เจ้าของ

# บัญชีผู้ดูแลระบบ (admin) — ตั้งรหัสผ่านที่เดายากเพื่อสร้างบัญชีตอนรัน pnpm db:seed
SEED_ADMIN_LOGIN=admin@fitflow.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# ชื่อสาขาที่พิมพ์บนใบเสร็จของบัญชีเจ้าของ
# SHOP_BRANCH=สาขาหลัก

# ข้อมูลร้านบนใบเสร็จ/ใบกำกับภาษีอย่างย่อ และ PromptPay (เบอร์มือถือ 10 หลัก หรือเลขผู้เสียภาษี 13 หลัก)
# SHOP_LEGAL_NAME=บริษัท ฟิตโฟลว์ จำกัด
# SHOP_ADDRESS=123 ถ.พหลโยธิน แขวงสามเสนใน เขตพญาไท กรุงเทพฯ 10400
# SHOP_TAX_ID=0105500000000
# SHOP_PHONE=02-123-4567
# PROMPTPAY_ID=0812345678

# โดเมนของเว็บ (ใช้ในลิงก์ชำระเงินของข้อความแจ้งเตือน) และความจุยิม (คน)
# APP_URL=https://fitflow.example.com
# GYM_CAPACITY=120

# ---------- ข้อมูลตัวอย่าง (pnpm db:sample) ----------
# รหัสผ่านของบัญชีตัวอย่างทุกบัญชี
#   เจ้าของ owner@fitflow.test / tatar · ผู้จัดการ manager@fitflow.test · เคาน์เตอร์ desk@fitflow.test
#   เทรนเนอร์ boss@fitflow.test · สมาชิก เบอร์ 080-000-0101
# DEMO_PASSWORD=1234
# on = ตรึงเวลาไว้ที่ 15 ต.ค. 2569 18:42 น. ให้ตรงกับข้อมูลตัวอย่าง (ใช้งานจริงห้ามตั้ง)
# DEMO_CLOCK=on

# ฐานข้อมูลสำหรับ integration test ของ DAL (pnpm test) — ข้อมูลถูกลบทุกครั้ง ห้ามชี้ไปฐานข้อมูลจริง
# TEST_DATABASE_URL=mysql://fitflow:change-me@127.0.0.1:3306/fitflow_test

# ทดสอบผ่าน http://IP ก่อนมีโดเมน/HTTPS — ปิด cookie แบบ secure ให้ล็อกอินได้ · ห้ามเปิดเมื่อใช้งานจริง
# ALLOW_HTTP=1

# pnpm start (production) — ค่าเริ่มต้น PORT=3001, HOSTNAME=127.0.0.1 (รับเฉพาะในเครื่อง ให้ IIS/Caddy ที่มี HTTPS อยู่ด้านหน้า)
# ตั้ง HOSTNAME=0.0.0.0 เมื่อให้เครื่องอื่นเข้าที่ http://IP:3001 ตรง ๆ (คู่กับ ALLOW_HTTP=1 ตอนทดสอบ)
# PORT=3001
# HOSTNAME=127.0.0.1
